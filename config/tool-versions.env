# Versions of the command-line tools this project installs itself. Changing a version here
# changes it for the laptop (scripts/install_conftest.sh) and for GitHub Actions alike.
#
# conftest runs the Rego rules in policies/rego against Terraform plans (Release 3).
# Releases: https://github.com/open-policy-agent/conftest/releases
CONFTEST_VERSION=0.56.0
