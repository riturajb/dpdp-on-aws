# Copy to config/local.env (ignored by Git) and fill in from the Terraform outputs.
# Used by the tests.

DPDP_PROFILE_WORKLOAD=dpdp-workload-eng
DPDP_PROFILE_SANDBOX=dpdp-sandbox-eng
DPDP_PROFILE_LOGARCHIVE=dpdp-logarchive-admin

# workload = run against Fernleaf Finance (fictional), the live model company; sandbox = clean-room run before a release
DPDP_TARGET=workload

DPDP_CLOUDTRAIL_BUCKET=dpdp-cloudtrail-logs-222222222222
DPDP_EVIDENCE_LIVE_BUCKET=dpdp-evidence-live-222222222222
DPDP_EVIDENCE_SANDBOX_BUCKET=dpdp-evidence-sandbox-222222222222
DPDP_TRAIL_ARN=arn:aws:cloudtrail:ap-south-1:111111111111:trail/dpdp-organization-trail
