{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllRegionsExceptMumbai",
      "Effect": "Deny",
      "NotAction": [
        "a4b:*", "account:*", "acm:*", "aws-marketplace-management:*", "aws-marketplace:*",
        "aws-portal:*", "budgets:*", "ce:*", "chime:*", "cloudfront:*", "config:*", "cur:*", "directconnect:*",
        "ec2:DescribeRegions", "ec2:DescribeTransitGateways", "ec2:DescribeVpnGateways", "fms:*",
        "globalaccelerator:*", "health:*", "iam:*", "identitystore:*", "importexport:*", "kms:*",
        "networkmanager:*", "organizations:*", "pricing:*", "route53:*", "route53domains:*",
        "s3:GetAccountPublic*", "s3:ListAllMyBuckets", "s3:ListMultiRegionAccessPoints", "s3:PutAccountPublic*",
        "shield:*", "sso:*", "sts:*", "support:*", "tag:GetResources", "trustedadvisor:*",
        "waf-regional:*", "waf:*", "wafv2:*", "wellarchitected:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ["ap-south-1"]
        }
      }
    }
  ]
}
